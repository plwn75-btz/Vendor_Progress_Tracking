# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest cache
.pytest_cache/

# Office temporary lock files generated by Excel/Word/PowerPoint
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx

