.env
.venv/
env/
venv/
ENV/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Heavy PDF files stay on local PC only (GitHub upload & repo size limits).
# Their essential data (Gantt, S-curves, milestones, sub-orders, action items)
# is extracted into "Export Data File.xlsx" (via Dashboard UI or python export_dashboard_data.py),
# which IS uploaded and read by the dashboard on Render.
KOM/
WPR/
MOM/
superseded/
*.tmp.xlsx

